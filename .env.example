# Base de datos (Neon en producción). Nombre propio a propósito: ver prisma.config.ts.
JORNADA_DATABASE_URL=postgresql://usuario:clave@host/jornada?sslmode=require

# URL pública de la app (enlaces de acceso y de verificación).
APP_URL=https://jornada.ugtclmgranada.org

# Correo (Brevo). Sin clave, el enlace de acceso sale en el log del servidor (solo desarrollo).
BREVO_API_KEY=
MAIL_FROM_EMAIL=jornada@ugtclmgranada.org
MAIL_FROM_NAME=Registro de jornada

# Sello de tiempo RFC 3161. Por defecto FreeTSA (gratuito, no cualificado).
# Para una autoridad cualificada eIDAS: su URL, el nombre que saldrá en los informes
# y, si la pide, la autenticación (Basic "usuario:clave" o una cabecera completa).
TSA_URL=https://freetsa.org/tsr
TSA_NAME=FreeTSA (no cualificada)
TSA_QUALIFIED=0
TSA_BASIC_AUTH=
TSA_AUTH_HEADER=
TSA_POLICY_OID=

# Responsable del tratamiento (sale en el aviso legal y de privacidad).
RESPONSABLE_NOMBRE=Sección Sindical de UGT en el Centro de Lenguas Modernas (Universidad de Granada)
RESPONSABLE_NIF=
RESPONSABLE_DIRECCION=
RESPONSABLE_CONTACTO=

# Secreto para el cron que sella las anotaciones pendientes (Authorization: Bearer).
CRON_SECRET=
