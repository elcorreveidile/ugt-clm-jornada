# Copiar a .env en el servidor y rellenar. Este fichero NUNCA se sube a GitHub.

# Dominio de la app (el registro DNS tipo A debe apuntar a la IP del servidor).
DOMINIO=jornada.ugtclmgranada.org

# Contraseña de la base de datos (inventa una larga: p. ej. `openssl rand -hex 24`).
POSTGRES_PASSWORD=

# Correo (Brevo): clave de API y remitente de un dominio verificado en Brevo.
BREVO_API_KEY=
MAIL_FROM_EMAIL=jornada@ugtclmgranada.org
MAIL_FROM_NAME=Registro de jornada

# Responsable del tratamiento (sale en el aviso legal).
RESPONSABLE_NOMBRE=Sección Sindical de UGT en el Centro de Lenguas Modernas (Universidad de Granada)
RESPONSABLE_NIF=
RESPONSABLE_DIRECCION=
RESPONSABLE_CONTACTO=

# Sello de tiempo. Por defecto FreeTSA (gratuita, no cualificada). Ver README para una cualificada.
TSA_URL=https://freetsa.org/tsr
TSA_NAME=FreeTSA (no cualificada)
TSA_QUALIFIED=0
